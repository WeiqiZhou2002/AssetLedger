# PostgreSQL 登录用户名
# 自动部署维护的镜像版本；本地手动构建使用 local
FINTRACKER_IMAGE_TAG=local
POSTGRES_USER=asset_ledger
# PostgreSQL 密码：请替换；建议用随机十六进制，避免连接 URL 中的保留字符
POSTGRES_PASSWORD=replace-with-random-hex-password
# PostgreSQL 数据库名
POSTGRES_DB=asset_ledger
# 本地开发数据库地址；Compose 会改为内部 db 主机
DATABASE_URL=postgresql://asset_ledger:replace-with-random-hex-password@localhost:5432/asset_ledger
# 浏览器访问的完整来源；远程部署必须改为你的 HTTPS 域名
APP_URL=http://localhost:3000
# 可选的额外完整来源，逗号分隔；例如 http://localhost:3000，必须同时匹配来源和 Host
EXTRA_ALLOWED_ORIGINS=
# 应用主密钥：必填且至少 32 字符；留空强制配置，变更会使已加密的 TOTP 密钥不可读
APP_SECRET=
# 可选自动化管理员预设：邮箱和密码都非空时首次启动创建；已有用户时不覆盖
# 默认留空，运行 scripts/setup.sh 在浏览器中完成首次设置
ADMIN_EMAIL=
# 管理员密码：12–1024 字符；创建完成后可删除本变量
ADMIN_PASSWORD=
# 默认基准货币
BASE_CURRENCY=USD
# 默认时区
TZ=America/Los_Angeles
# 上传文件保存路径；Docker 使用命名卷 /data，不得放在 public 中
DATA_DIR=./data
# 内部解析服务地址；本地未运行解析服务时留空即禁用健康探测
PARSER_URL=
# 单个上传文件大小上限（MB）；Excel 迁移另限最多 5 MB
MAX_UPLOAD_MB=20
# PDF 解锁、解析与预览的最大页数
MAX_PDF_PAGES=60
# 汇率过期天数
FX_STALE_DAYS=7
# 账户余额过期天数
STALE_ACCOUNT_DAYS=14
# 账单批准后原件与页面缓存保留天数；未批准文件不自动清理
FILE_RETENTION_DAYS=30
# AI 解析默认关闭；启用后仍须逐份预览并确认发送交易区域文本
AI_PARSING_ENABLED=false
# 可选 Claude API 密钥；默认留空
ANTHROPIC_API_KEY=
# 可选 AI 模型；留空使用 claude-opus-5-5，发送前展示
AI_MODEL=
# 仅在所有请求均经可信 Cloudflare Tunnel 且源站不可被不可信客户端直连时设 true
TRUST_CLOUDFLARE_HEADERS=false
# Cloudflare 控制台创建的 Tunnel token；只用于 tunnel profile
CLOUDFLARE_TUNNEL_TOKEN=
# 主机备份/恢复口令；脚本需显式导出此变量，不自动读取本文件，不注入容器；不得与 APP_SECRET 相同
BACKUP_PASSPHRASE=

# 演示用户邮箱：仅显式 db:seed --demo 时使用，不自动注入容器
DEMO_EMAIL=
# 演示用户密码：至少 12 字符，不打印；不得使用真实所有者邮箱
DEMO_PASSWORD=

# 银行同步默认关闭，也可在 设置 → 银行连接 中测试并保存凭据后启用
# PLAID_CLIENT_ID 和 PLAID_SECRET 都非空时，环境变量优先且页面只读
# 同步间隔与历史范围始终使用环境变量；启用后账户与交易资料会通过 Plaid
PLAID_ENABLED=false
# 仅 sandbox 或 production；开发和 smoke 测试只允许 sandbox
PLAID_ENV=sandbox
# Plaid Dashboard 中的 client_id；仅注入 web 与 worker
PLAID_CLIENT_ID=
# 与上面环境匹配的 Plaid secret；不得放入浏览器、日志或导出
PLAID_SECRET=
# 可选 OAuth 返回地址：注册到 Plaid Dashboard，建议 https://你的域名/plaid/oauth；无 query/hash
# 仅 Sandbox 允许 http://localhost:3000/plaid/oauth
PLAID_REDIRECT_URI=
# 定时同步间隔（小时），缓存余额通常约每日更新；不调用付费实时余额接口
PLAID_SYNC_INTERVAL_HOURS=12
# PLAID_HISTORY_START 未设/留空时的回退历史天数（1–730）；初始化后不能修改该 Item 的窗口
PLAID_DAYS_REQUESTED=90
# 可选固定起始日期；留空 = 最近 PLAID_DAYS_REQUESTED 天；已有 Item 的历史深度和导入日期不变
PLAID_HISTORY_START=
