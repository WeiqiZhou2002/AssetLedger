        "accounts_last4_check": {
          "name": "accounts_last4_check",
          "value": "\"accounts\".\"last4\" IS NULL OR \"accounts\".\"last4\" ~ '^[0-9]{4}$'"
        },
        "accounts_currency_check": {
          "name": "accounts_currency_check",
          "value": "\"accounts\".\"currency\" ~ '^[A-Z]{3}$'"
        },
        "accounts_days_check": {
          "name": "accounts_days_check",
          "value": "(\"accounts\".\"statement_day\" IS NULL OR \"accounts\".\"statement_day\" BETWEEN 1 AND 31) AND (\"accounts\".\"payment_due_day\" IS NULL OR \"accounts\".\"payment_due_day\" BETWEEN 1 AND 31)"
        },
        "accounts_dates_check": {
          "name": "accounts_dates_check",
          "value": "\"accounts\".\"opened_on\" IS NULL OR \"accounts\".\"closed_on\" IS NULL OR \"accounts\".\"closed_on\" >= \"accounts\".\"opened_on\""
        },
        "accounts_system_check": {
          "name": "accounts_system_check",
          "value": "\"accounts\".\"is_system\" = (\"accounts\".\"type\" IN ('income','expense','equity_opening','fx_clearing','reconciliation_adjustment'))"
        },
        "accounts_inclusion_check": {
          "name": "accounts_inclusion_check",
          "value": "NOT \"accounts\".\"cash_like_inclusion\" OR \"accounts\".\"type\" IN ('asset_cash','asset_brokerage_cash','liability_credit_card','liability_loan')"
        }
