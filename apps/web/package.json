{
  "name": "@asset-ledger/web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:scripts",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/admin.ts",
    "worker": "tsx worker/index.ts",
    "build:scripts": "node scripts/build.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,css,json}\" ../../package.json ../../.prettierrc \"../../fixtures/**/*.{ts,tsx}\" ../../scripts/plaid-sandbox-smoke.ts",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,css,json}\" ../../package.json ../../.prettierrc \"../../fixtures/**/*.{ts,tsx}\" ../../scripts/plaid-sandbox-smoke.ts",
    "db:seed": "tsx scripts/seed.ts",
    "plaid:sandbox-smoke": "tsx --tsconfig tsconfig.json ../../scripts/plaid-sandbox-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@node-rs/argon2": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "plaid": "^49.0.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
